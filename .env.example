# Copy this file to ".env" and paste your keys in. Never commit .env to GitHub.

# Google Gemini API key (free) - get one at https://aistudio.google.com/apikey
# Used to read uploaded invoices (vision) and write the plain-English explanation.
GEMINI_API_KEY=

# Optional: change the model if this one isn't available on your key
GEMINI_MODEL=gemini-3.8-flash

# Optional: Australian Business Register web services GUID (free) for LIVE ABN lookups
# Register at https://abr.business.gov.au/Tools/WebServices (the GUID is emailed to you)
ABR_GUID=

# Port the app runs on
PORT=3000

# Payments of this amount or more get the full Invoice Check (smaller ones go straight through unless unusual)
LARGE_PAYMENT_THRESHOLD=5000

# ---------- Usage limits (protect your Gemini quota on a public link) ----------
# Gemini calls per day for the whole app, and invoice scans per visitor per hour
GEMINI_DAILY_LIMIT=500
SCANS_PER_HOUR=30

# ---------- Keep the database when a free host restarts (optional) ----------
# Free Redis database at https://upstash.com -> Create database -> REST API -> copy these two values
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Forward invoices by email (optional) ----------
# A Gmail address made for the app, and an app password from https://myaccount.google.com/apppasswords (needs 2-Step Verification)
EMAIL_USER=
EMAIL_APP_PASSWORD=
# Seconds between inbox checks, and checks per sender per day
EMAIL_POLL_SECONDS=60
EMAILS_PER_SENDER_PER_DAY=20
# Replies: on Render's free plan Gmail can't send (SMTP is blocked), so use Brevo's free email API instead:
# https://www.brevo.com -> SMTP & API -> API keys, and add EMAIL_USER as a verified sender
BREVO_API_KEY=
# Link to the app in reply emails (Render sets this automatically)
APP_URL=
# Lets an email service (e.g. CloudMailin) post emails to /api/email/inbound?token=...
INBOUND_TOKEN=
